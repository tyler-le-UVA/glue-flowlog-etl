{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadRawFlowLogs",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::glue-flowlog-etl-raw-209901331329-us-east-1/raw/AWSLogs/*"
        },
        {
            "Sid": "ListBuckets",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": [
                "arn:aws:s3:::glue-flowlog-etl-raw-209901331329-us-east-1",
                "arn:aws:s3:::glue-flowlog-etl-curated-209901331329-us-east-1"
            ]
        },
        {
            "Sid": "ReadWriteCurated",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::glue-flowlog-etl-curated-209901331329-us-east-1/*"
        },
        {
            "Sid": "UseProjectKey",
            "Effect": "Allow",
            "Action": [
                "kms:Decrypt",
                "kms:GenerateDataKey"
            ],
            "Resource": "arn:aws:kms:us-east-1:209901331329:key/fa34605e-7a79-4b3b-b8d4-124479d86dd7"
        }
    ]
}
