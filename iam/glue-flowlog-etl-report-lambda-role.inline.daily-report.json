{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "Athena",
            "Effect": "Allow",
            "Action": [
                "athena:StartQueryExecution",
                "athena:GetQueryExecution",
                "athena:GetQueryResults"
            ],
            "Resource": "arn:aws:athena:us-east-1:209901331329:workgroup/flowlogs-wg"
        },
        {
            "Sid": "CatalogReadFindings",
            "Effect": "Allow",
            "Action": [
                "glue:GetDatabase",
                "glue:GetTable",
                "glue:GetPartition",
                "glue:GetPartitions",
                "glue:BatchGetPartition"
            ],
            "Resource": [
                "arn:aws:glue:us-east-1:209901331329:catalog",
                "arn:aws:glue:us-east-1:209901331329:database/flowlogs_db",
                "arn:aws:glue:us-east-1:209901331329:table/flowlogs_db/findings"
            ]
        },
        {
            "Sid": "ReadFindingsWriteReports",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::glue-flowlog-etl-curated-209901331329-us-east-1/findings/*",
                "arn:aws:s3:::glue-flowlog-etl-curated-209901331329-us-east-1/reports/*"
            ]
        },
        {
            "Sid": "AthenaResults",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:AbortMultipartUpload"
            ],
            "Resource": "arn:aws:s3:::glue-flowlog-etl-athena-results-209901331329/*"
        },
        {
            "Sid": "ListBuckets",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": [
                "arn:aws:s3:::glue-flowlog-etl-curated-209901331329-us-east-1",
                "arn:aws:s3:::glue-flowlog-etl-athena-results-209901331329"
            ]
        },
        {
            "Sid": "ProjectKey",
            "Effect": "Allow",
            "Action": [
                "kms:Decrypt",
                "kms:GenerateDataKey"
            ],
            "Resource": "arn:aws:kms:us-east-1:209901331329:key/fa34605e-7a79-4b3b-b8d4-124479d86dd7"
        },
        {
            "Sid": "Bedrock",
            "Effect": "Allow",
            "Action": "bedrock:InvokeModel",
            "Resource": [
                "arn:aws:bedrock:*::foundation-model/*",
                "arn:aws:bedrock:us-east-1:209901331329:inference-profile/*"
            ]
        },
        {
            "Sid": "Email",
            "Effect": "Allow",
            "Action": "sns:Publish",
            "Resource": "arn:aws:sns:us-east-1:209901331329:glue-flowlog-etl-alerts"
        }
    ]
}
