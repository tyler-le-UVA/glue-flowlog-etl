{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "InteractiveSessions",
            "Effect": "Allow",
            "Action": [
                "glue:CreateSession",
                "glue:GetSession",
                "glue:StopSession",
                "glue:DeleteSession",
                "glue:RunStatement",
                "glue:GetStatement",
                "glue:ListStatements",
                "glue:CancelStatement",
                "glue:TagResource"
            ],
            "Resource": "arn:aws:glue:us-east-1:209901331329:session/*"
        },
        {
            "Sid": "ListSessions",
            "Effect": "Allow",
            "Action": "glue:ListSessions",
            "Resource": "*"
        },
        {
            "Sid": "PassSelfToGlue",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::209901331329:role/glue-flowlog-etl-job-role",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "glue.amazonaws.com"
                }
            }
        }
    ]
}
